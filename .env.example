# Backend
# Supabase pooled connection (runtime / Prisma Client)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase direct connection (migrations / introspection)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:5432/postgres"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_PROMPT_VERSION="v1"
PORT="4000"

# Frontend
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"

# Local Docker database defaults
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/support_ops?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:54322/support_ops?schema=public"
